{
  "_说明": "场景套件定义。基于 base 数据做增删改，派生出多组用例，一次跑完。",
  "_字段": {
    "name": "场景名，会出现在报告里",
    "expect": "这个场景想验证什么，写给人看",
    "remove": "要删掉的字段路径数组，支持 a.b.c 与 a.b[0]",
    "set": "要设置的字段，键是路径，值是内容"
  },
  "base": "../demo-merged-ticket.json",
  "scenarios": [
    {
      "name": "基线-完整数据",
      "expect": "所有分区都应显示，不应有任何错误",
      "remove": [],
      "set": {}
    },
    {
      "name": "仅税",
      "expect": "汇总行文案为 Tax，弹层只列税项",
      "remove": [],
      "set": {
        "taxFeeDetailInfo.title": "Tax",
        "taxFeeDetailInfo.contentList": [
          { "content": ["Sales Tax", "$1.02"], "fontSize": 14 }
        ]
      }
    },
    {
      "name": "仅费",
      "expect": "汇总行文案为 Fees，弹层只列费用项",
      "remove": [],
      "set": {
        "taxFeeDetailInfo.title": "Fees",
        "taxFeeDetailInfo.contentList": [
          { "content": ["Service Fee", "$0.80"], "fontSize": 14 }
        ]
      }
    },
    {
      "name": "无税无费",
      "expect": "不渲染 i 图标，不渲染弹层与弹层 JS",
      "remove": ["taxFeeDetailInfo"],
      "set": {}
    },
    {
      "name": "无顾客信息",
      "expect": "顾客分区整块不渲染，分隔线不重复",
      "remove": ["customerInfo"],
      "set": {}
    },
    {
      "name": "无支付信息",
      "expect": "Payment 整块不渲染（含标题与分隔线）",
      "remove": ["tradeInfo"],
      "set": {}
    },
    {
      "name": "无门店Logo",
      "expect": "不出图片，按配置决定是否走占位图标",
      "remove": ["merchantInfo.logo"],
      "set": {}
    },
    {
      "name": "OO取餐码胶囊",
      "expect": "胶囊显示「类型 / 取餐码」，不显示桌台",
      "remove": ["orderInfo.table"],
      "set": {
        "orderInfo.orderChannel": 1
      }
    },
    {
      "name": "堂食有桌台",
      "expect": "胶囊只显示 Dine In，不拼接桌台号",
      "remove": [],
      "set": {
        "orderInfo.orderChannel": 0
      }
    },
    {
      "name": "带整单备注",
      "expect": "整单备注正常渲染，备注上下均有分割线",
      "remove": [],
      "set": {
        "orderNoteInfo": {
          "block": { "lineSpace": 4 },
          "contentList": [{ "content": ["Note: no napkins, please"], "fontSize": 13 }]
        }
      }
    },
    {
      "name": "有门店Logo",
      "expect": "logo 有值时渲染图片，不走占位图标",
      "remove": [],
      "set": {
        "merchantInfo.logo": "https://cdn.example.com/store-logo.png"
      }
    },
    {
      "name": "配置关闭餐品分区",
      "expect": "ticketConfig.meal.showPart 为 false 时餐品整块不渲染",
      "remove": [],
      "set": {
        "ticketConfig": { "meal": { "showPart": false } }
      }
    },
    {
      "name": "配置关闭门店分区",
      "expect": "ticketConfig.merchant.showPart 为 false 时页头整块不渲染",
      "remove": [],
      "set": {
        "ticketConfig": { "merchant": { "showPart": false } }
      }
    },
    {
      "name": "配置关闭金额分区",
      "expect": "ticketConfig.expense.showPart 为 false 时金额整块不渲染",
      "remove": [],
      "set": {
        "ticketConfig": { "expense": { "showPart": false } }
      }
    },
    {
      "name": "单号为字符串",
      "expect": "orderNumber 是纯字符串时也能正常渲染（环境差异兼容）",
      "remove": [],
      "set": {
        "orderInfo.orderNumber": "#1"
      }
    },
    {
      "name": "费用行内外重复下发",
      "expect": "模版不做去重，服务费在主票和弹层各显示一次；重复属数据侧问题，需后端不再平铺该行（禅道 6039）",
      "remove": [],
      "set": {
        "orderAmountInfo.contentList": [
          { "content": ["Subtotal", "$12.00"], "fontSize": 14, "bold": 400 },
          { "id": "taxFees", "content": ["Taxes & Fees", "$27.04"], "fontSize": 14, "bold": 400 },
          { "content": ["Kiosk Fee (10%)", "$3.16"], "fontSize": 14, "bold": 400 },
          { "content": ["OPF (10%)", "$3.16"], "fontSize": 14, "bold": 400 },
          { "content": ["Processing Fee", "$3.10"], "fontSize": 14, "bold": 400 },
          { "id": "total", "content": ["Total", "$44.54"], "fontSize": 22, "bold": 700 }
        ]
      }
    },
    {
      "name": "刷卡费误灌进弹层",
      "expect": "模版原样展示客户端下发的弹层明细；Processing Fee 出现在弹层属于客户端数据问题",
      "remove": [],
      "set": {
        "taxFeeDetailInfo.contentList": [
          { "content": ["Kiosk Fee (10%)", "$3.16"], "fontSize": 14, "category": "service" },
          { "content": ["Tax1 (12%)", "$8.22"], "fontSize": 14, "category": "tax" },
          { "content": ["Processing Fee", "$3.10"], "fontSize": 14, "category": "processing" }
        ]
      }
    },
    {
      "name": "门店电话未格式化",
      "expect": "后端下发 4782733578 时模版补成 478-273-3578 并加粗（禅道 6041）",
      "remove": [],
      "set": {
        "merchantInfo.contentList[2]": {
          "content": ["4782733578"],
          "fontSize": 14,
          "bold": 400
        }
      }
    },
    {
      "name": "顾客电话未格式化",
      "expect": "后端下发 4782733578 时，顾客电话按 478-273-3578 展示",
      "remove": [],
      "set": {
        "customerInfo.contentList[3]": {
          "content": ["4782733578"],
          "fontSize": 14,
          "bold": 400
        }
      }
    },
    {
      "name": "汇总行未下发 ID",
      "expect": "缺少 id=taxFees 时不显示明细图标，模版不按文案猜测",
      "remove": ["orderAmountInfo.contentList[1].id"],
      "set": {}
    },
    {
      "name": "仅费用汇总行",
      "expect": "汇总行文案可以是 Fees，只要下发 id=taxFees 就显示明细图标",
      "remove": [],
      "set": {
        "orderAmountInfo.contentList[1].content": ["Fees", "$6.32"],
        "taxFeeDetailInfo.title": "Fees",
        "taxFeeDetailInfo.contentList": [
          { "content": ["Kiosk Fee (10%)", "$3.16"], "fontSize": 14, "category": "service" },
          { "content": ["OPF (10%)", "$3.16"], "fontSize": 14, "category": "platform" }
        ]
      }
    }
  ]
}
